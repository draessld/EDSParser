# C/C++
*.o
*.a
*.so
*.out
*.exe
*.dll
*.dylib
*.obj
*.elf
*.gch
*.pch
*.dSYM/
*.su
*.idb
*.pdb
*.mod
*.smod
*.lai
*.la
*.lo

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
!EDSParserConfig.cmake.in
# Build-system modules we ship. The blanket *.cmake above is aimed at generated
# files (cmake_install.cmake and friends), but it also swallowed cmake/ — which
# is how 593456b shipped a src/cpp/lib/CMakeLists.txt referencing
# cmake/GitVersion.cmake without the file, breaking a clean build at HEAD.
!cmake/*.cmake

# Build directories
build/
bin/
obj/
out/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Compiled test executables (keep source .cpp files)
tests/unit/test_*
!tests/unit/test_*.cpp

# Benchmark results (keep .gitkeep and baseline.csv)
tests/bench/results/*
!tests/bench/results/.gitkeep

# Documentation
docs/_build/
*.pdf.bak
tex/

# Logs
*.log
cmd_history.log

# Temporary files
*.tmp
*.temp
tmp/
temp/
Testing/

# OS files
Thumbs.db
.DS_Store

# CLAUDE
*.md
!CLAUDE.md
!TODO.md
.claude/
!docs/*.md
!tests/bench/README.md
!tests/bench/requirements.txt
!tests/bench/docs/
!tests/bench/docs/*.png

# Experiment outputs - track the scripts, exclude all dataset content and results
experiments/*
!experiments/scripts/
!experiments/*.py
!experiments/*.md
!experiments/*.sh
experiments/scripts/*
!experiments/scripts/*.sh
# xbench configuration is source, not output. It has to be re-included
# explicitly: `experiments/*` excludes the directory itself, and git cannot
# re-include a file whose parent directory is excluded.
!experiments/specs/
!experiments/specs/*.yaml
!experiments/specs/hooks/
!experiments/specs/hooks/*.py
# experiments/runs/ stays excluded by the rule above — run directories carry
# work/ trees that can be tens of GB.
data/site/
site/

# Generated l-EDS output accidentally written to e2e data dir
tests/e2e/data/*_l[0-9]*.leds
tests/e2e/data/*_l[0-9]*.seds
